digraph Phase0AOverview {
  graph [rankdir=TB,bgcolor="#FFFFFF",pad="0.35",nodesep="0.48",ranksep="0.52",splines=ortho,fontname="Microsoft YaHei",fontsize=18,fontcolor="#0F172A",label="Phase 0A · 主调用链：Runner 返回结果，领域层收敛状态",labelloc=t,labeljust=c,newrank=true];
  node [shape=box,style="rounded,filled",fontname="Microsoft YaHei",fontsize=10.5,fontcolor="#0F172A",color="#64748B",penwidth=1.2,margin="0.20,0.12"];
  edge [color="#64748B",penwidth=1.3,arrowsize=0.72,fontname="Microsoft YaHei",fontsize=8.5,fontcolor="#475569"];

  user [label="本地用户 / API 调用方",fillcolor="#F8FAFC",group="main"];
  api [label="① FastAPI Diagnosis API\n接收请求，不执行诊断逻辑",fillcolor="#E8F3FF",color="#3B82F6",group="main",penwidth=1.7];
  start [label="② DiagnosisApplicationService\n启动调查 · 事务 · 并发保护",fillcolor="#E8F3FF",color="#0284C7",group="main",penwidth=1.7];
  runner [label="③ ToolLoopRunner\n模型提议 + 确定性约束",fillcolor="#F0EDFF",color="#7C3AED",group="main",penwidth=2.1];
  result [label="ToolLoopResult\n结论 · 终止原因 · 预算消耗",fillcolor="#F0EDFF",color="#7C3AED",group="main"];
  apply [label="④ DiagnosisApplicationService._apply_result()\n解释运行结果，选择领域动作",fillcolor="#E8F3FF",color="#0284C7",group="main",penwidth=1.7];
  diagnosis [label="⑤ DiagnosisCase\n状态机执行合法转换并持久化",fillcolor="#E8F3FF",color="#2563EB",group="main",penwidth=2.0];

  governance [label="请求治理\nRequest ID · 统一异常\n结构化日志 · 健康检查",fillcolor="#E8F3FF",color="#60A5FA",group="left"];
  strategy [label="DiagnosisStrategy\n系统提示 · 工具白名单",fillcolor="#F0EDFF",color="#7C3AED",group="left"];
  registry [label="Tool Registry\n注册 · 权限 · 参数 · 超时",fillcolor="#E2F6EF",color="#0D9488",group="right"];
  records [label="AgentRun / ToolRun\n轮次 · 调用 · 错误 · 终止原因",fillcolor="#E2F6EF",color="#0D9488",group="right"];

  user -> api [color="#F59E0B",penwidth=2.6];
  api -> start [label="run diagnosis",color="#F59E0B",penwidth=2.6];
  start -> runner [label="启动 AgentRun",color="#F59E0B",penwidth=2.6];
  runner -> result [label="收敛或受控终止",color="#F59E0B",penwidth=2.6];
  result -> apply [label="返回，不改领域状态",color="#F59E0B",penwidth=2.6];
  apply -> diagnosis [label="调用领域状态方法",color="#F59E0B",penwidth=2.6];

  governance -> api [style=dashed,label="治理",color="#60A5FA"];
  strategy -> runner [label="允许的工具",color="#7C3AED"];
  runner -> registry [label="每次 Tool Call 校验",color="#0D9488"];
  registry -> runner [style=dashed,label="ToolExecutionResult",color="#0D9488",constraint=false];
  runner -> records [label="追加执行事实",color="#0D9488"];

  {rank=same; governance; api;}
  {rank=same; strategy; runner; registry;}
  {rank=same; apply; records;}
}
