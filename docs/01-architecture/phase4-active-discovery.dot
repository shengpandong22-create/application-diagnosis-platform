digraph Phase4Discovery {
  graph [rankdir=TB,bgcolor="#FFFFFF",pad="0.35",nodesep="0.34",ranksep="0.62",splines=ortho,fontname="Microsoft YaHei",fontsize=18,fontcolor="#0F172A",label="Phase 4 · 日志主动发现与诊断闭环",labelloc=t,labeljust=l,compound=true,newrank=true];
  node [shape=box,style="rounded,filled",fontname="Microsoft YaHei",fontsize=10,fontcolor="#0F172A",color="#64748B",penwidth=1.1,margin="0.16,0.10"];
  edge [color="#64748B",penwidth=1.3,arrowsize=0.7,fontname="Microsoft YaHei",fontsize=8.5,fontcolor="#475569"];

  subgraph cluster_sources {
    label="① 事件来源"; color="#93C5FD"; fillcolor="#EFF6FF"; style="rounded,filled";
    sources [label="File / Replay / RabbitMQ\nLogEventSource",fillcolor="#E8F3FF",color="#3B82F6"];
  }
  subgraph cluster_domain {
    label="② 确定性发现核心"; color="#5EEAD4"; fillcolor="#F0FDFA"; style="rounded,filled";
    logevent [label="LogEvent\n标准化事件",fillcolor="#E2F6EF",color="#0D9488"];
    fingerprint [label="ErrorFingerprint v1\n异常 + 服务 + 业务栈",fillcolor="#E2F6EF",color="#0D9488"];
    incident [label="Incident Aggregation\n时间窗 · 次数 · 样本",fillcolor="#E2F6EF",color="#0D9488"];
    policy [label="DiagnosisTriggerPolicy\n重复 / 已关联 / 可触发",fillcolor="#E8F3FF",color="#3B82F6"];
  }
  subgraph cluster_diagnosis {
    label="③ 复用 Phase 0～3 诊断闭环"; color="#C4B5FD"; fillcolor="#FAF8FF"; style="rounded,filled";
    create [label="Diagnosis + 初始 Evidence\n关联 incident_id",fillcolor="#E8F3FF",color="#3B82F6"];
    runtime [label="受控 Agent Runtime\nTool · Evidence · Citation",fillcolor="#F0EDFF",color="#7C3AED"];
    outcome [label="Report / Confirmation\nAudit / Knowledge",fillcolor="#EDF7E5",color="#65A30D"];
  }
  retained [label="只保留 Incident 事实\n不启动新的 AgentRun",fillcolor="#FFF1DD",color="#D97706"];

  sources -> logevent [color="#F59E0B",penwidth=2.4];
  logevent -> fingerprint [color="#0D9488",penwidth=2.1];
  fingerprint -> incident [color="#0D9488",penwidth=2.1];
  incident -> policy [color="#F59E0B",penwidth=2.4];
  policy -> retained [label="duplicate / linked",color="#D97706"];
  policy -> create [label="incident_without_diagnosis",color="#F59E0B",penwidth=2.4];
  create -> runtime [color="#F59E0B",penwidth=2.4];
  runtime -> outcome [color="#F59E0B",penwidth=2.4];
  outcome -> incident [style=dashed,label="人工反馈与运营复盘",color="#65A30D",constraint=false];
}
